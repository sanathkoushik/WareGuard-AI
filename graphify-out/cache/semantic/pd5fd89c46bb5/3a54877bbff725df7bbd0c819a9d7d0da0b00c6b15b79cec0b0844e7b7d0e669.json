{"nodes": [{"id": "docs_behavior_risk_behaviorengine", "label": "BehaviorEngine", "file_type": "concept", "source_file": "docs/behavior-risk.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_behavior_risk_riskengine", "label": "RiskEngine", "file_type": "concept", "source_file": "docs/behavior-risk.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_behavior_risk_thresholds", "label": "Thresholds (profiles: default, sensitive, strict)", "file_type": "concept", "source_file": "docs/behavior-risk.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_behavior_risk_scenecontext", "label": "SceneContext.assumed_cargo_height_m", "file_type": "concept", "source_file": "docs/behavior-risk.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_behavior_risk_assessment_to_assistant_context", "label": "assessment_to_assistant_context()", "file_type": "concept", "source_file": "docs/behavior-risk.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_behavior_risk_drop_behavior", "label": "drop behavior signature", "file_type": "concept", "source_file": "docs/behavior-risk.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Requires an abrupt stop after vertical fall; without that requirement every careful set-down would also score as a drop."}, {"id": "docs_behavior_risk_throw_behavior", "label": "throw behavior signature", "file_type": "concept", "source_file": "docs/behavior-risk.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Requires free-fall vertical acceleration (approx g, unsupported); horizontal speed at height alone cannot distinguish a thrown box from a carried or shoved one."}, {"id": "docs_behavior_risk_drag_behavior", "label": "drag behavior signature", "file_type": "concept", "source_file": "docs/behavior-risk.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_behavior_risk_improper_stack_behavior", "label": "improper_stack behavior signature", "file_type": "concept", "source_file": "docs/behavior-risk.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_behavior_risk_rough_handling_behavior", "label": "rough_handling behavior signature", "file_type": "concept", "source_file": "docs/behavior-risk.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keyed on jerk, not speed, so a fast smooth carry stays clean while a sharp yank triggers it; the 12 h/s^2 threshold sits between a controlled set-down (~6) and a deliberate shove (~23)."}, {"id": "docs_behavior_risk_source_agnostic_design", "label": "Source-agnostic design (track-schema seam)", "file_type": "rationale", "source_file": "docs/behavior-risk.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "behavior/ and risk/ never look at video; they consume a track schema, so YOLOv8 output, ground-truth simulated tracks, and real CCTV all enter through the same door and swapping the detector changes nothing downstream."}, {"id": "docs_behavior_risk_standard_library_only_design", "label": "Standard-library-only design", "file_type": "rationale", "source_file": "docs/behavior-risk.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No torch, ultralytics, cv2, numpy or pandas dependency in behavior/ or risk/, so the whole analysis stack runs on a machine with no vision dependencies installed, in milliseconds rather than minutes."}, {"id": "docs_behavior_risk_severity_vs_priority", "label": "Severity vs priority distinction", "file_type": "rationale", "source_file": "docs/behavior-risk.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "risk_score answers how bad an event would be; priority_score multiplies it by detector confidence to answer what to review first. Ranking by priority while displaying severity avoids hiding dangerous-but-uncertain events."}, {"id": "docs_behavior_risk_data_quality_warning", "label": "data_quality_warning / zero-events handling", "file_type": "concept", "source_file": "docs/behavior-risk.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Zero events does not mean no risk: an empty event list on unanalysable footage must never render as a green all-clear tile, so UIs must surface summary.data_quality_warning and use summary.headline() rather than composing their own string from the counts."}, {"id": "docs_behavior_risk_scale_invariance", "label": "Object-heights-per-second units (scale invariance)", "file_type": "rationale", "source_file": "docs/behavior-risk.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every threshold is normalised by the object's own median bbox height (cancels pixel scale) and divided by elapsed time (cancels frame rate), so the same numeric thresholds work unchanged on 720p and 4K footage."}, {"id": "docs_behavior_risk_overlap_resolution", "label": "Overlapping-claim resolution (throw > drop > stack > drag > rough)", "file_type": "rationale", "source_file": "docs/behavior-risk.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Overlapping behavior claims on the same object at the same moment collapse to the most specific one; suppressed alternatives are appended to the survivor's description rather than discarded."}, {"id": "docs_behavior_risk_known_limitation", "label": "Known limitation: detection layer track continuity", "file_type": "concept", "source_file": "docs/behavior-risk.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "On sample_warehouse.mp4, yolov8n produces 46 tracks of which the longest survives 4 frames, with 37 misclassified as sports ball; behavior/simulation.py exists because current detection output cannot support this analysis, and the (correct, tested) behavior engine stays quiet on that log until detection produces continuous tracks."}], "edges": [{"source": "readme_run_analysis_py", "target": "docs_behavior_risk_behaviorengine", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/behavior-risk.md", "source_location": null, "weight": 1.0}, {"source": "readme_run_analysis_py", "target": "docs_behavior_risk_riskengine", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/behavior-risk.md", "source_location": null, "weight": 1.0}, {"source": "docs_behavior_risk_riskengine", "target": "docs_behavior_risk_behaviorengine", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/behavior-risk.md", "source_location": null, "weight": 1.0}, {"source": "docs_behavior_risk_behaviorengine", "target": "docs_behavior_risk_thresholds", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/behavior-risk.md", "source_location": null, "weight": 1.0}, {"source": "docs_behavior_risk_behaviorengine", "target": "docs_behavior_risk_drop_behavior", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/behavior-risk.md", "source_location": null,